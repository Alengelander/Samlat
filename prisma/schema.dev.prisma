// LOKALES ENTWICKLUNGS-SCHEMA (SQLite, ohne Docker).
// Modelle MUESSEN mit prisma/schema.prisma (PostgreSQL, Docker) uebereinstimmen.
// Nutzung:  npm run dev:db   (schreibt prisma/dev.db)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DEV_DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Box {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  size      String   @default("M")
  location  String?
  notes     String?
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Item {
  id        String   @id @default(cuid())
  boxId     String
  box       Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())

  @@index([boxId])
  @@index([name])
}

// Samlat — Kisten- & Inhaltsverwaltung
// Prisma schema. DB wird per `prisma db push` beim Container-Start aktualisiert.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model BoxType {
  id         String   @id @default(cuid())
  name       String   @unique // z.B. "Umzugskarton", "Werkzeugkiste"
  dimensions String? // frei, z.B. "40 x 30 x 25 cm"
  sortOrder  Int      @default(0)
  boxes      Box[]
  createdAt  DateTime @default(now())
}

model Box {
  id        String   @id @default(cuid())
  code      String   @unique // kurzer Code fuer QR/URL, z.B. "K7Q2MP"
  name      String
  typeId    String?
  type      BoxType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  location  String?
  notes     String?
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([typeId])
}

model Item {
  id        String   @id @default(cuid())
  boxId     String
  box       Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())

  @@index([boxId])
  @@index([name])
}

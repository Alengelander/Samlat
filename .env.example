# --- Datenbank ---
POSTGRES_USER=samlat
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=samlat

# Von der App genutzte Verbindung (Host "db" = Compose-Service).
DATABASE_URL=postgresql://samlat:change-me-db-password@db:5432/samlat?schema=public

# --- Auth ---
# Geheimnis fuer die Session-Signatur. Erzeugen mit:  openssl rand -base64 32
AUTH_SECRET=change-me-auth-secret

# Erster Login-Benutzer (wird beim Start angelegt/aktualisiert).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Basis-URL der App (fuer QR-Code-Links auf den Etiketten).
APP_URL=http://localhost:3000
